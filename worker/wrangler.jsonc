{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aetherquant-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aetherquant-db",
      "database_id": "YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "aetherquant-storage"
    }
  ],
  "vars": {
    "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
    "DEEPSEEK_MODEL": "deepseek-chat",
    "R2_SYSTEM_SAFE_LIMIT_BYTES": 8589934592, // 8GB Safe limit Rule 15
    "QUANT_SERVICE_URL": "https://aetherquant-quant-service.onrender.com"
  },
  "triggers": {
    "crons": [
      "0 17 * * 1-5", // CN Daily Post-Market Sync (17:00 CST)
      "0 22 * * 1-5", // US Daily Post-Market Sync (22:00 EST)
      "0 2 * * *"     // Daily Storage Cleanup & Reconciliation
    ]
  }
}
